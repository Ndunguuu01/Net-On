{
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*", "prisma/**/*", "test/**/*.ts"],
  "compilerOptions": {
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"],
      "@modules/*": ["src/modules/*"],
      "@common/*": ["src/common/*"],
      "@config/*": ["src/config/*"]
    },
    "types": ["node", "jest", "supertest"]
  }
}

