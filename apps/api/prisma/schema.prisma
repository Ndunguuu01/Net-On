// ============================================
// Net-On — Prisma Schema
// ============================================
// This is the initial schema for Phase 1.
// Entities will be expanded in Phase 2 (Database).
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// User & Authentication
// ============================================

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  passwordHash  String    @map("password_hash")
  role          String    @default("CUSTOMER")
  isActive      Boolean   @default(true) @map("is_active")
  failedLogins  Int       @default(0) @map("failed_logins")
  lockedUntil   DateTime? @map("locked_until")
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  customer      Customer?
  staffMember   StaffMember?
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  @@map("users")
}

model RefreshToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @map("token_hash")
  family      String    @default(uuid())
  isRevoked   Boolean   @default(false) @map("is_revoked")
  expiresAt   DateTime  @map("expires_at")
  userAgent   String?   @map("user_agent")
  ipAddress   String?   @map("ip_address")
  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// ============================================
// Customer
// ============================================

model Customer {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @unique @map("user_id") @db.Uuid
  customerNumber       String    @unique @map("customer_number")
  firstName            String    @map("first_name")
  lastName             String    @map("last_name")
  phone                String    @unique
  email                String?
  address              String?
  installationAddress  String?   @map("installation_address")
  location             String?
  status               String    @default("ACTIVE")
  balance              Decimal   @default(0) @db.Decimal(12, 2)
  loyaltyPoints        Int       @default(0) @map("loyalty_points")
  expiryDate           DateTime? @map("expiry_date")
  notes                String?
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  // Relations
  user                 User      @relation(fields: [userId], references: [id])
  subscriptions        Subscription[]
  invoices             Invoice[]
  payments             Payment[]
  networkAccount       NetworkAccount?
  devices              Device[]
  childAccounts        ChildAccount[]
  notifications        Notification[]
  supportTickets       SupportTicket[]

  @@index([status])
  @@index([phone])
  @@map("customers")
}

// ============================================
// Internet Package & Network Profile
// ============================================

model NetworkProfile {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @unique
  description    String?
  downloadSpeed  Int      @map("download_speed")
  uploadSpeed    Int      @map("upload_speed")
  speedUnit      String   @default("Mbps") @map("speed_unit")
  rateLimitString String  @map("rate_limit_string")
  burstConfig    String?  @map("burst_config")
  addressPool    String?  @map("address_pool")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  packages       InternetPackage[]
  networkAccounts NetworkAccount[]

  @@map("network_profiles")
}

model InternetPackage {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  description      String?
  price            Decimal  @db.Decimal(12, 2)
  billingCycle     String   @default("MONTHLY") @map("billing_cycle")
  durationDays     Int      @map("duration_days")
  downloadSpeed    Int      @map("download_speed")
  uploadSpeed      Int      @map("upload_speed")
  speedUnit        String   @default("Mbps") @map("speed_unit")
  gracePeriodDays  Int      @default(3) @map("grace_period_days")
  networkProfileId String?  @map("network_profile_id") @db.Uuid
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  networkProfile   NetworkProfile? @relation(fields: [networkProfileId], references: [id])
  subscriptions    Subscription[]
  childAccounts    ChildAccount[]

  @@index([status])
  @@map("internet_packages")
}

// ============================================
// Subscription
// ============================================

model Subscription {
  id              String   @id @default(uuid()) @db.Uuid
  customerId      String   @map("customer_id") @db.Uuid
  packageId       String   @map("package_id") @db.Uuid
  startDate       DateTime @map("start_date") @db.Date
  expiryDate      DateTime @map("expiry_date") @db.Date
  status          String   @default("ACTIVE")
  autoRenew       Boolean  @default(true) @map("auto_renew")
  gracePeriodDays Int      @default(3) @map("grace_period_days")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  customer        Customer @relation(fields: [customerId], references: [id])
  package         InternetPackage @relation(fields: [packageId], references: [id])
  invoices        Invoice[]

  @@index([status])
  @@index([expiryDate])
  @@index([customerId])
  @@map("subscriptions")
}

// ============================================
// Invoice
// ============================================

model Invoice {
  id                 String   @id @default(uuid()) @db.Uuid
  invoiceNumber      String   @unique @map("invoice_number")
  customerId         String   @map("customer_id") @db.Uuid
  subscriptionId     String?  @map("subscription_id") @db.Uuid
  billingPeriodStart DateTime @map("billing_period_start") @db.Date
  billingPeriodEnd   DateTime @map("billing_period_end") @db.Date
  issueDate          DateTime @map("issue_date") @db.Date
  dueDate            DateTime @map("due_date") @db.Date
  subtotal           Decimal  @db.Decimal(12, 2)
  discount           Decimal  @default(0) @db.Decimal(12, 2)
  tax                Decimal  @default(0) @db.Decimal(12, 2)
  total              Decimal  @db.Decimal(12, 2)
  amountPaid         Decimal  @default(0) @map("amount_paid") @db.Decimal(12, 2)
  balance            Decimal  @db.Decimal(12, 2)
  status             String   @default("PENDING")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // Relations
  customer           Customer @relation(fields: [customerId], references: [id])
  subscription       Subscription? @relation(fields: [subscriptionId], references: [id])
  items              InvoiceItem[]
  payments           Payment[]

  @@index([status])
  @@index([dueDate])
  @@index([customerId])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @map("invoice_id") @db.Uuid
  description String
  quantity    Int      @default(1)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

// ============================================
// Payment
// ============================================

model Payment {
  id                    String   @id @default(uuid()) @db.Uuid
  customerId            String   @map("customer_id") @db.Uuid
  invoiceId             String?  @map("invoice_id") @db.Uuid
  amount                Decimal  @db.Decimal(12, 2)
  provider              String
  transactionReference  String   @unique @map("transaction_reference")
  providerTransactionId String?  @map("provider_transaction_id")
  phoneNumber           String?  @map("phone_number")
  status                String   @default("PENDING")
  reconciliationStatus  String   @default("PENDING") @map("reconciliation_status")
  providerMetadata      Json?    @map("provider_metadata")
  paidAt                DateTime? @map("paid_at")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  // Relations
  customer              Customer @relation(fields: [customerId], references: [id])
  invoice               Invoice? @relation(fields: [invoiceId], references: [id])

  @@index([status])
  @@index([transactionReference])
  @@index([customerId])
  @@map("payments")
}

// ============================================
// Router & Network
// ============================================

model Router {
  id                String    @id @default(uuid()) @db.Uuid
  name              String
  managementIp      String    @map("management_ip")
  apiPort           Int       @default(8728) @map("api_port")
  apiUsername        String    @map("api_username")
  encryptedPassword String    @map("encrypted_password")
  location          String?
  status            String    @default("ONLINE")
  capabilities      Json?
  lastHealthCheck   DateTime? @map("last_health_check")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // Relations
  networkAccounts   NetworkAccount[]
  syncJobs          NetworkSyncJob[]
  childAccounts     ChildAccount[]

  @@map("routers")
}

model NetworkAccount {
  id                   String    @id @default(uuid()) @db.Uuid
  customerId           String    @unique @map("customer_id") @db.Uuid
  username             String    @unique
  passwordReference    String    @map("password_reference")
  authenticationMethod String    @default("HOTSPOT_USER") @map("authentication_method")
  routerId             String    @map("router_id") @db.Uuid
  networkProfileId     String?   @map("network_profile_id") @db.Uuid
  ipAddress            String?   @map("ip_address")
  macAddress           String?   @map("mac_address")
  status               String    @default("PENDING")
  syncStatus           String    @default("PENDING") @map("sync_status")
  pppoeUsername        String?   @map("pppoe_username")
  overrideProfileId    String?   @map("override_profile_id") @db.Uuid
  overrideExpiresAt    DateTime? @map("override_expires_at")
  lastSyncedAt         DateTime? @map("last_synced_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  // Relations
  customer             Customer @relation(fields: [customerId], references: [id])
  router               Router   @relation(fields: [routerId], references: [id])
  networkProfile       NetworkProfile? @relation(fields: [networkProfileId], references: [id])
  device               Device?
  sessions             NetworkSession[]
  syncJobs             NetworkSyncJob[]

  @@index([status])
  @@index([syncStatus])
  @@map("network_accounts")
}

// ============================================
// Device (ONU / CPE Hardware)
// ============================================

model Device {
  id                    String    @id @default(uuid()) @db.Uuid
  customerId            String    @map("customer_id") @db.Uuid
  networkAccountId      String?   @unique @map("network_account_id") @db.Uuid
  deviceName            String?   @map("device_name")
  deviceModel           String?   @map("device_model")
  deviceSerial          String?   @unique @map("device_serial")
  macAddress            String?   @map("mac_address")
  ipAddress             String?   @map("ip_address")
  status                String    @default("ONLINE")
  wifiSsid              String?   @map("wifi_ssid")
  wifiPasswordEncrypted String?   @map("wifi_password_encrypted")
  lastSeenAt            DateTime? @map("last_seen_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  // Relations
  customer              Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  networkAccount        NetworkAccount? @relation(fields: [networkAccountId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([macAddress])
  @@map("devices")
}

// ============================================
// Child Account (Sub-accounts under parent Customer)
// ============================================

model ChildAccount {
  id                   String    @id @default(uuid()) @db.Uuid
  customerId           String    @map("customer_id") @db.Uuid
  packageId            String?   @map("package_id") @db.Uuid
  routerId             String?   @map("router_id") @db.Uuid
  username             String    @unique
  passwordReference    String    @map("password_reference")
  ipAddress            String?   @map("ip_address")
  macAddress           String?   @map("mac_address")
  status               String    @default("ACTIVE")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  // Relations
  customer             Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  package              InternetPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  router               Router?   @relation(fields: [routerId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([status])
  @@map("child_accounts")
}

model NetworkSession {
  id               String    @id @default(uuid()) @db.Uuid
  networkAccountId String    @map("network_account_id") @db.Uuid
  sessionId        String    @map("session_id")
  ipAddress        String?   @map("ip_address")
  macAddress       String?   @map("mac_address")
  bytesIn          BigInt    @default(0) @map("bytes_in")
  bytesOut         BigInt    @default(0) @map("bytes_out")
  uptimeSeconds    Int       @default(0) @map("uptime_seconds")
  startedAt        DateTime  @map("started_at")
  endedAt          DateTime? @map("ended_at")

  // Relations
  networkAccount   NetworkAccount @relation(fields: [networkAccountId], references: [id])

  @@map("network_sessions")
}

model NetworkSyncJob {
  id               String    @id @default(uuid()) @db.Uuid
  networkAccountId String    @map("network_account_id") @db.Uuid
  routerId         String    @map("router_id") @db.Uuid
  operation        String
  status           String    @default("PENDING")
  retryCount       Int       @default(0) @map("retry_count")
  maxRetries       Int       @default(5) @map("max_retries")
  errorMessage     String?   @map("error_message")
  payload          Json?
  scheduledAt      DateTime  @default(now()) @map("scheduled_at")
  startedAt        DateTime? @map("started_at")
  completedAt      DateTime? @map("completed_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  // Relations
  networkAccount   NetworkAccount @relation(fields: [networkAccountId], references: [id])
  router           Router @relation(fields: [routerId], references: [id])

  @@index([status])
  @@map("network_sync_jobs")
}

// ============================================
// Notification
// ============================================

model Notification {
  id         String    @id @default(uuid()) @db.Uuid
  customerId String    @map("customer_id") @db.Uuid
  channel    String
  type       String
  subject    String?
  message    String
  status     String    @default("PENDING")
  metadata   Json?
  sentAt     DateTime? @map("sent_at")
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  // Relations
  customer   Customer  @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([status])
  @@map("notifications")
}

// ============================================
// Support
// ============================================

model SupportTicket {
  id           String    @id @default(uuid()) @db.Uuid
  customerId   String    @map("customer_id") @db.Uuid
  assignedTo   String?   @map("assigned_to") @db.Uuid
  ticketNumber String    @unique @map("ticket_number")
  subject      String
  description  String
  category     String?
  priority     String    @default("MEDIUM")
  status       String    @default("OPEN")
  resolvedAt   DateTime? @map("resolved_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relations
  customer     Customer  @relation(fields: [customerId], references: [id])

  @@index([status])
  @@index([customerId])
  @@map("support_tickets")
}

// ============================================
// Audit Log
// ============================================

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  result     String   @default("SUCCESS")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId, action])
  @@index([resource, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================
// System Settings
// ============================================

model SystemSetting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       String
  type        String   @default("string")
  category    String   @default("general")
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

// ============================================
// Staff Member
// ============================================

model StaffMember {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  firstName       String    @map("first_name")
  lastName        String    @map("last_name")
  phone           String
  department      String    @default("Operations")
  specialization  String?
  status          String    @default("ACTIVE")
  hireDate        DateTime  @default(now()) @map("hire_date") @db.Date
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  user            User      @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([department])
  @@map("staff_members")
}
