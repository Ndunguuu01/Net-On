# ============================================
# Net-On ISP Management Platform
# Environment Configuration
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ============================================

# -------------------------------------------
# General
# -------------------------------------------
NODE_ENV=development
APP_NAME=Net-On
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# -------------------------------------------
# API Server
# -------------------------------------------
API_PORT=3001
API_PREFIX=api/v1
API_CORS_ORIGINS=http://localhost:3000

# -------------------------------------------
# Database (PostgreSQL)
# -------------------------------------------
DATABASE_URL=postgresql://neton:neton_dev_password@localhost:5432/neton?schema=public
DB_HOST=localhost
DB_PORT=5432
DB_NAME=neton
DB_USER=neton
DB_PASSWORD=neton_dev_password

# -------------------------------------------
# Redis
# -------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# -------------------------------------------
# Authentication (JWT)
# -------------------------------------------
JWT_ACCESS_SECRET=change-this-to-a-long-random-string-at-least-64-chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=change-this-to-a-different-long-random-string-at-least-64-chars
JWT_REFRESH_EXPIRATION=7d

# -------------------------------------------
# Encryption (AES-256-GCM)
# -------------------------------------------
ENCRYPTION_SECRET=change-this-to-a-random-string-at-least-32-chars

# -------------------------------------------
# Safaricom M-Pesa (Daraja API)
# -------------------------------------------
# Get credentials from https://developer.safaricom.co.ke
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here
MPESA_PASSKEY=your_passkey_here
MPESA_SHORTCODE=174379
MPESA_CALLBACK_BASE_URL=https://your-domain.com
MPESA_API_BASE_URL=https://sandbox.safaricom.co.ke
# Set to 'mock' during development to use MockPaymentProvider
MPESA_MODE=mock

# Webhook verification secret — append as ?token=<secret> to the Daraja callback URL
MPESA_WEBHOOK_SECRET=change-this-to-a-random-webhook-secret

# -------------------------------------------
# MikroTik RouterOS
# -------------------------------------------
# These are DEFAULT values for the primary router.
# Additional routers are configured through the admin UI.
MIKROTIK_DEFAULT_HOST=192.168.88.1
MIKROTIK_DEFAULT_PORT=8728
MIKROTIK_DEFAULT_USER=admin
MIKROTIK_DEFAULT_PASSWORD=your_mikrotik_password
# Set to 'mock' during development to use MockNetworkAdapter
MIKROTIK_MODE=mock

# -------------------------------------------
# SMS Provider
# -------------------------------------------
# Supported: africas_talking, mock
SMS_PROVIDER=mock
AFRICASTALKING_API_KEY=your_api_key_here
AFRICASTALKING_USERNAME=your_username_here
AFRICASTALKING_SENDER_ID=NET-ON

# -------------------------------------------
# Email
# -------------------------------------------
EMAIL_PROVIDER=mock
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=noreply@neton.co.ke
EMAIL_FROM_NAME=Net-On

# -------------------------------------------
# Admin Seed (created on first run)
# -------------------------------------------
ADMIN_EMAIL=admin@neton.co.ke
ADMIN_PASSWORD=ChangeThisPassword123!
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Administrator

# -------------------------------------------
# Logging
# -------------------------------------------
LOG_LEVEL=debug
LOG_FORMAT=pretty

# -------------------------------------------
# Rate Limiting
# -------------------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=100
AUTH_THROTTLE_TTL=60
AUTH_THROTTLE_LIMIT=5
